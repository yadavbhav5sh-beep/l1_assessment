    {
      "name": "73c41cb2",
      "displayName": "fact_sales",
      "config": {
        "version": "1.1",
        "source": "tpch_dev.gold.fact_sales",
        "dimensions": [
          {
            "expr": "order_key"
          },
          {
            "expr": "line_number"
          },
          {
            "expr": "customer_key"
          },
          {
            "expr": "product_key"
          },
          {
            "expr": "supplier_key"
          },
          {
            "expr": "order_date"
          },
          {
            "name": "order_month",
            "expr": "DATE_TRUNC('MONTH', order_date)"
          },
          {
            "expr": "ship_date"
          },
          {
            "expr": "receipt_date"
          },
          {
            "expr": "order_status"
          },
          {
            "expr": "order_priority"
          },
          {
            "expr": "ship_mode"
          },
          {
            "expr": "return_flag"
          },
          {
            "expr": "line_status"
          },
          {
            "expr": "customer_nation_name"
          },
          {
            "expr": "customer_region_name"
          },
          {
            "expr": "supplier_nation_name"
          },
          {
            "expr": "supplier_region_name"
          }
        ],
        "measures": [
          {
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "net_revenue",
            "expr": "SUM(net_revenue)",
            "comment": "Sum of net revenue across all sales lines"
          },
          {
            "name": "distinct_orders",
            "expr": "COUNT(DISTINCT order_key)",
            "displayName": "Distinct Orders",
            "comment": "Number of distinct orders"
          },
          {
            "name": "active_customers",
            "expr": "COUNT(DISTINCT customer_key)",
            "displayName": "Active Customers",
            "comment": "Number of distinct customers with sales"
          },
          {
            "displayName": "Average Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_order_value",
            "expr": "MEASURE(net_revenue) / MEASURE(distinct_orders)",
            "comment": "Net revenue divided by distinct order count"
          },
          {
            "displayName": "Average Discount Rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_discount_rate",
            "expr": "AVG(discount)",
            "comment": "Average line-level discount rate"
          },
          {
            "displayName": "Total Discount Amount",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "total_discount_amount",
            "expr": "SUM(discount_amount)",
            "comment": "Sum of discount amounts"
          },
          {
            "displayName": "Average Shipping Days",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "avg_shipping_days",
            "expr": "AVG(DATEDIFF(ship_date, order_date))",
            "comment": "Average days between order date and ship date"
          }
        ]
      }
    },
    {
      "name": "066ec289",
      "displayName": "vw_annual_sales_kpis",
      "config": {
        "version": "1.1",
        "source": "tpch_dev.gold.vw_annual_sales_kpis",
        "dimensions": [
          {
            "expr": "source.*"
          }
